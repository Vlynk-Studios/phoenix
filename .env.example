# Application database
DATABASE_URL=postgresql://correos:CHANGE_ME@127.0.0.1:5432/correos

# Test database
DATABASE_URL_TEST=postgresql://correos:CHANGE_ME@127.0.0.1:5432/correos_test

# Superuser connection — only needed for db:setup (Route B). Remove after setup.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Microsoft Graph / Outlook
OUTLOOK_CLIENT_ID=
OUTLOOK_AUTHORITY=https://login.microsoftonline.com/common

# Email tracking
INTERVALO_MINUTOS=5
DIAS_SEGUIMIENTO=30
AVISAR_EN=primera
MAX_INTENTOS_AVISO=5
RUTA_CACHE_TOKEN=.token_cache.json

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
